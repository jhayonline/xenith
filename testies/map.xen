# Test maps with types
let user: map<string, string> = {
    "name": "Alice",
    "city": "New York"
}

let ages: map<string, int> = {
    "alice": 25,
    "bob": 31
}

# Iterate over keys
echo("Keys:")
for key in user.keys() {
    echo("  {key}")
}

# Iterate over values
echo("Values:")
for value in user.values() {
    echo("  {value}")
}

# Iterate over key-value pairs
echo("All entries:")
for key, value in ages {
    echo("  {key}: {value}")
}

# Get map length
echo("Map has {user.len()} entries")
