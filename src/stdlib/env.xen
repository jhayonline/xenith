# std::env
#
# The process environment: variables, the command line, the working directory,
# and the exit status. Everything a program needs to find out how it was
# started.
#
# Reading a variable hands back a pair:
#
#     let (port, found) = get("PORT")
#     when !found { port = "8080" }
#
# A variable that is unset and one set to the empty string are different
# things, and a single string cannot tell them apart. Most of the time you do
# not care, and `get_or` is the shorter form for that case:
#
#     let port: string = get_or("PORT", "8080")

grab { is_empty, lower } from "std::string"

# ---------------------------------------------------------------------------
# Variables
# ---------------------------------------------------------------------------

# The value, and whether the variable was set at all.
export method get(name: string) -> (string, bool) {
    release env_get(name)
}

# The value, or `fallback` when the variable is unset. A variable set to the
# empty string counts as set, and gives "" rather than the fallback.
export method get_or(name: string, fallback: string) -> string {
    let (value, found) = env_get(name)
    when !found {
        release fallback
    }
    release value
}

export method has(name: string) -> bool {
    let (value, found) = env_get(name)
    release found
}

# Sets a variable for this process and anything it starts. It does not reach
# the shell that started this program; no process can change its parent's
# environment.
export method set(name: string, value: string) -> null {
    release env_set(name, value)
}

export method unset(name: string) -> null {
    release env_unset(name)
}

# Every variable, as a map. A name whose value is not valid UTF-8 is left out.
export method all() -> map<string, string> {
    release env_vars()
}

# A variable read as an int, and whether it was set and parsed. Written out
# rather than left to the caller because a port or a worker count arriving as
# text is most of what the environment is used for.
export method get_int(name: string) -> (int, bool) {
    let (value, found) = env_get(name)
    when !found || is_empty(value) {
        release (0, false)
    }
    release (value as int, true)
}

# A variable read as a flag. "1", "true", "yes" and "on" are true, whatever the
# case; anything else, including unset, is false.
export method get_flag(name: string) -> bool {
    let (value, found) = env_get(name)
    when !found {
        release false
    }

    let flag: string = lower(value)
    release flag == "1" || flag == "true" || flag == "yes" || flag == "on"
}

# ---------------------------------------------------------------------------
# The command line
# ---------------------------------------------------------------------------

# The whole command line: the program being run, then whatever followed it.
export method args() -> list<string> {
    release env_args()
}

# Just the arguments, without the program name. This is what a script that
# takes options actually wants.
export method params() -> list<string> {
    let full: list<string> = env_args()
    when full.len() <= 1 {
        release []
    }

    let rest: list<string> = []
    for (let i: int = 1; i < full.len(); i++) {
        rest.append(full[i])
    }
    release rest
}

# The path of the program being run, as it was typed.
export method program() -> string {
    let full: list<string> = env_args()
    when full.len() == 0 {
        release ""
    }
    release full[0]
}

# ---------------------------------------------------------------------------
# The process
# ---------------------------------------------------------------------------

# The working directory, and an error which is empty on success.
export method cwd() -> (string, string) {
    release env_cwd()
}

# Stops the program with an exit status. Nothing after it runs, including
# anything a caller was going to do with the result, so this is for the end of
# a program and not for reporting a failure up a call chain.
export method exit(code: int) -> null {
    release env_exit(code)
}
