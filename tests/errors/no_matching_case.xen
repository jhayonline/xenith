# The checker follows `grab`, so it knows what variants `Visible` has and sees
# the hole here before anything runs.
#
# This used to be the other way round: the checker did not read imported
# modules, so it could not see the missing arm, and the interpreter reported
# XEN023 at the point the match fell off the end. Now the whole import graph is
# walked and checked first, so the missing variant is named up front.
grab { Visible } from "hidden_struct"

let value: Visible = Visible::Third

let text: string = match value {
    Visible::First(n) => "first {n}"
    Visible::Second(s) => "second {s}"
}
echo(text)
