let xs: list<int> = [3, 1, 2]
echo("{xs} {xs.len()} {xs[0]}")
xs.append(9)
echo("{xs}")
xs[0] = 99
echo("{xs}")
let popped: int = xs.pop(0)
echo("popped {popped} left {xs}")
echo("{[1, 2] + [3]}")
let grid: list<list<int>> = [[1, 2, 3], [4, 5, 6]]
echo("{grid[1][2]}")
grid[0][0] = 7
echo("{grid[0]}")
let multi: list<string> = [
    "a",
    "b",
]
echo("{multi}")
let base: list<int> = [1, 2]
echo("{append(base, 3)} {extend(base, [8])} {pop(base, 0)} {base}")
