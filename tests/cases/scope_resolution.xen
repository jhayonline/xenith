# Cases where remembering where a name lives could go wrong.
# Each of these resolves the same syntax against a different scope.

# Dynamic scoping: one method body, two callers, two different `n`.
method show() -> null {
    echo("{n}")
    release null
}
method first() -> null {
    let n: int = 111
    show()
    release null
}
method second() -> null {
    let n: string = "a string"
    show()
    release null
}
first()
second()
first()

# Shadowing: the inner binding wins inside the block and nowhere else.
let v: int = 1
for (let i: int = 0; i < 3; i++) {
    let v: int = 100 + i
    echo("inner {v}")
}
echo("outer {v}")

# Recursion runs the same nodes against many frames.
method sum_to(n: int) -> int {
    when n <= 0 { release 0 }
    release n + sum_to(n - 1)
}
echo("{sum_to(50)}")
echo("{sum_to(3)}")
echo("{sum_to(50)}")

# A method reaching out to a caller's variable, at two call depths.
let counter: int = 0
method bump() -> null {
    counter = counter + 1
    release null
}
method wrapper() -> null {
    bump()
    bump()
    release null
}
bump()
wrapper()
echo("counter {counter}")

# Declarations that only happen on some iterations.
for (let i: int = 0; i < 4; i++) {
    when i % 2 == 0 {
        let even: int = i * 10
        echo("even {even}")
    } otherwise {
        let odd: int = i * 100
        echo("odd {odd}")
    }
}
