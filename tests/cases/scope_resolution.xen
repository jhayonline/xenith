# Cases where remembering where a name lives could go wrong, and the scoping
# rules those depend on.

# A method sees the scope it was written in. `total` is declared beside it, so
# the method can read and change it.
let total: int = 0
method bump() -> null {
    total = total + 1
    release null
}
method wrapper() -> null {
    bump()
    bump()
    release null
}
bump()
wrapper()
echo("total {total}")

# A name declared after the method is still visible, because the capture is
# live rather than a snapshot.
method report() -> null {
    echo("later is {later}")
    release null
}
let later: int = 7
report()

# A closure keeps the values around its own definition, and two of them made
# from the same method are independent.
type IntFn = method(int) -> int
method make_adder(n: int) -> IntFn {
    release method(x: int) -> int => x + n
}
let add_ten: IntFn = make_adder(10)
let add_one: IntFn = make_adder(1)
echo("{add_ten(5)} {add_one(5)} {add_ten(5)}")

# Shadowing: the inner binding wins inside the block and nowhere else.
let v: int = 1
for (let i: int = 0; i < 3; i++) {
    let v: int = 100 + i
    echo("inner {v}")
}
echo("outer {v}")

# Recursion runs the same nodes against many frames.
method sum_to(n: int) -> int {
    when n <= 0 { release 0 }
    release n + sum_to(n - 1)
}
echo("{sum_to(50)}")
echo("{sum_to(3)}")
echo("{sum_to(50)}")

# The same method called from two places, where each call passes a different
# value. This is what a method reading a caller's local used to look like, and
# it now has to be an argument.
method show(value: int) -> null {
    echo("showing {value}")
    release null
}
method first() -> null {
    let n: int = 111
    show(n)
    release null
}
method second() -> null {
    let n: int = 222
    show(n)
    release null
}
first()
second()
first()

# Declarations that only happen on some iterations.
for (let i: int = 0; i < 4; i++) {
    when i % 2 == 0 {
        let even: int = i * 10
        echo("even {even}")
    } otherwise {
        let odd: int = i * 100
        echo("odd {odd}")
    }
}
