# std::string, which is written in Xenith and built into the binary.

grab { trim, trim_start, trim_end } from "std::string"
grab { upper, lower, reverse, repeat } from "std::string"
grab { is_empty, is_space, is_digit, is_alpha, is_upper, is_lower } from "std::string"
grab { starts_with, ends_with, contains, count } from "std::string"
grab { index_of, last_index_of } from "std::string"
grab { split, join, replace } from "std::string"
grab { pad_start, pad_end } from "std::string"

# Trimming
echo("[{trim("  hello  ")}]")
echo("[{trim("\t\n x \n\t")}]")
echo("[{trim("   ")}]")
echo("[{trim("")}]")
echo("[{trim_start("  left")}]")
echo("[{trim_end("right  ")}]")

# Case, ASCII only
echo(upper("hello World 123"))
echo(lower("HELLO World 123"))

# Whole string
echo(reverse("abcdef"))
echo("[{repeat("ab", 3)}]")
echo("[{repeat("ab", 0)}]")
echo("{is_empty("")} {is_empty("a")}")

# Characters
echo("{is_space(" ")} {is_space("a")}")
echo("{is_digit("7")} {is_digit("x")} {is_digit("77")}")
echo("{is_alpha("Q")} {is_alpha("1")}")
echo("{is_upper("Q")} {is_lower("q")}")

# Searching
echo("{starts_with("hello", "he")} {starts_with("hello", "lo")}")
echo("{ends_with("hello", "lo")} {ends_with("hello", "he")}")
echo("{contains("haystack", "stack")} {contains("haystack", "needle")}")
echo("{count("banana", "an")} {count("aaaa", "aa")} {count("abc", "z")}")

let (first, found_first) = index_of("hello world", "o")
echo("first {first} {found_first}")
let (last, found_last) = last_index_of("hello world", "o")
echo("last {last} {found_last}")
let (missing, found_missing) = index_of("abc", "z")
echo("missing {missing} {found_missing}")

# Splitting and joining
echo("{ret(split("a,b,c", ","))}")
echo("{ret(split("a,,b", ","))}")
echo("{ret(split(",lead", ","))}")
echo("{ret(split("trail,", ","))}")
echo("{ret(split("a::b::c", "::"))}")
echo("{ret(split("abc", ""))}")
echo("[{join(["a", "b", "c"], "-")}]")
echo("[{join([], "-")}]")
echo("[{replace("a-b-c", "-", "+")}]")
echo("[{replace("aaa", "a", "bb")}]")

# Padding
echo("[{pad_start("7", 3, "0")}]")
echo("[{pad_end("x", 4, ".")}]")
echo("[{pad_start("toolong", 3, "0")}]")

# The pieces compose, which is the point of writing it in the language.
method title_case(text: string) -> string {
    let words: list<string> = split(lower(trim(text)), " ")
    let out: list<string> = []
    for word in words {
        when is_empty(word) {
            skip
        }
        out.append(upper(word[0]) + substring(word, 1, word.len()))
    }
    release join(out, " ")
}
echo(title_case("  the QUICK brown   fox  "))
