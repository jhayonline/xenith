# Phase 4's slice: methods, calls, release, recursion and captures.
# Deliberately no string interpolation and no lists -- neither compiles yet,
# and a fixture that falls back to the tree walker proves nothing.

method add(a: int, b: int) -> int { release a + b }
method square(n: int) -> int => n * n
echo(add(2, 3))
echo(square(9))

# A method with no release returns null.
method silent() -> null { let unused: int = 1 }
echo(silent())

method fib(n: int) -> int {
    when n < 2 { release n }
    release fib(n - 1) + fib(n - 2)
}
echo(fib(20))

# A capture is read at call time, so a later change is seen.
let step: int = 1
method advance(n: int) -> int => n + step
echo(advance(0))
step = 50
echo(advance(0))

# Each call to make_adder produces a method holding its own n.
method make_adder(n: int) -> method(int) -> int {
    release method(x: int) -> int => x + n
}
let add_ten: method(int) -> int = make_adder(10)
let add_one: method(int) -> int = make_adder(1)
echo(add_ten(5))
echo(add_one(5))

# A write through a capture is seen by the variable it captured.
let counter: int = 0
method bump() -> null { counter = counter + 1 release null }
bump()
bump()
echo(counter)

# A method defined inside a block captures that block.
method build() -> method(int) -> int {
    let factor: int = 3
    release method(x: int) -> int => x * factor
}
let triple: method(int) -> int = build()
echo(triple(7))
